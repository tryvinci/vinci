#!/usr/bin/env bash
# Local CLI entry until a human publishes @tryvinci/cli. Do not npx the registry package.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ -d "$ROOT/.venv/bin" ]]; then
  export PATH="$ROOT/.venv/bin:$PATH"
fi
CLI="$ROOT/apps/cli/dist/index.js"
if [[ ! -f "$CLI" ]]; then
  if [[ ! -x "$ROOT/node_modules/.bin/tsc" ]]; then
    echo "Run make install first (from the repo root)." >&2
    exit 1
  fi
  (cd "$ROOT" && npm run build --workspace @tryvinci/cli)
fi
exec node "$CLI" "$@"
