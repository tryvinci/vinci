{
  "name": "@tryvinci/studio",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript Vinci Studio. Talks to the local daemon via /vinci-api. Daemon /studio remains the WebView shell.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 4311",
    "build": "NODE_ENV=production next build",
    "build:static": "VINCI_STUDIO_EXPORT=1 NODE_ENV=production next build",
    "start": "next start -p 4311",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0"
  }
}
